# Copy to .env beside docker-compose.yml. Every line is optional; the value shown is the default.

# Host side: where the container's port 8000 is published. 0.0.0.0 opens it to the network — set
# a key first.
BIND=127.0.0.1
PORT=8000

# Every setting below that is left empty is taken from what /admin chose last time (kept in the
# hf-cache volume), else from the built-in default; a value written here pins it.

# The checkpoint: a Hub id, downloaded once into the hf-cache volume, or a directory under
# /models (mounted from MODELS_DIR) for weights you already have, e.g. /models/typecastlm.
# Default mihailgribov/typecastlm-qwen3.5-3.8b.
TYPECASTLM_MODEL=
MODELS_DIR=./models

# Bearer token(s) the two /v1 routes require; several, separated by commas. Empty: no auth.
TYPECASTLM_API_KEY=

# Requests allowed to wait for the model before the next gets 529 + Retry-After.
TYPECASTLM_QUEUE=32
# Requests on the backend at once. Empty: 1 for weights held here, 8 for an embedding server or
# Jev, which queue for themselves.
TYPECASTLM_CONCURRENCY=

# auto picks CUDA when the container sees a GPU. bfloat16 is what the numbers were measured in.
TYPECASTLM_DEVICE=
TYPECASTLM_DTYPE=

# State tokens read in full (longer states are folded in the middle). Empty: the checkpoint's own
# limit, 32768.
TYPECASTLM_MAX_STATE_TOKENS=

# Where the model is. local loads the weights here (GPU). llama puts the API in front of a
# llama-server holding the GGUF at the endpoint below, and this container needs no GPU; openai
# does the same for any server with /v1/embeddings that returns the vector raw; jev proxies
# TypeSafe's Jev under the key below. Default local; all of it can be changed later at /admin.
TYPECASTLM_BACKEND=
# Empty takes the backend's own default: http://127.0.0.1:8080 for llama/openai (a llama-server
# on this machine outside Docker is http://host.docker.internal:8080), https://api.typesafe.ai for jev.
TYPECASTLM_BACKEND_ENDPOINT=
TYPECASTLM_BACKEND_KEY=

# Only for a private Hub checkpoint (or the GGUF repository while it is private).
HF_TOKEN=

# Which image: the published one by default, at this tag. IMAGE=typecastlm for a local build
# under its own name.
IMAGE=ghcr.io/mihail-gribov/typecastlm
IMAGE_TAG=latest

# With docker-compose.llama.yml (or .llama-cpu.yml): the llama.cpp sidecar that holds the GGUF.
# LLAMA_GGUF is repository:tag for `-hf`; LLAMA_CTX the longest prompt it takes (32768 for full
# states, more memory); LLAMA_CACHE_DIR a host directory instead of the llama-cache volume, e.g.
# ~/.cache/huggingface/hub when a host llama-server or `hf download` already fetched the file.
LLAMA_GGUF=mihailgribov/typecastlm-qwen3.5-3.8b:Q8_0
LLAMA_CTX=8192
# Tokens processed at once; sets the GPU compute buffer (2048 ≈ 1 GB, 8192 ≈ 9 GB).
LLAMA_UBATCH=2048
LLAMA_CACHE_DIR=
LLAMA_IMAGE=
LLAMA_THREADS=8
# Requests the sidecar answers at once; with --kv-unified they share the context rather than
# split it, so a long state beside short ones still fits.
LLAMA_PARALLEL=1
