# Copy to .env beside docker-compose.yml. Every line is optional; the value shown is the default.

# Host side: where the container's port 8000 is published. 0.0.0.0 opens it to the network — set
# a key first.
BIND=127.0.0.1
PORT=8000

# The checkpoint: a Hub id, downloaded once into the hf-cache volume, or a directory under
# /models (mounted from MODELS_DIR) for weights you already have, e.g. /models/typecastlm.
TYPECASTLM_MODEL=mihailgribov/typecastlm-qwen3.5-3.8b
MODELS_DIR=./models

# Bearer token(s) the two /v1 routes require; several, separated by commas. Empty: no auth.
TYPECASTLM_API_KEY=

# Requests allowed to wait for the model before the next gets 529 + Retry-After.
TYPECASTLM_QUEUE=32

# auto picks CUDA when the container sees a GPU. bfloat16 is what the numbers were measured in.
TYPECASTLM_DEVICE=auto
TYPECASTLM_DTYPE=bfloat16

# State tokens read in full (longer states are folded in the middle). Empty: the checkpoint's own
# limit, 32768.
TYPECASTLM_MAX_STATE_TOKENS=

# Only for a private Hub checkpoint.
HF_TOKEN=

# Tag for the built image.
IMAGE_TAG=latest
